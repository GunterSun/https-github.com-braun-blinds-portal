ton><label class=\"button\">↑ 导入订单<input type=\"file\" id=\"import\" accept=\"application/json\" hidden></label></header>\n<section id=\"work\"><p id=\"offline-status\" class=\"offline-status\" role=\"status\">正在检测运行环境…</p><div class=\"title\"><div><p class=\"eyebrow\">FABRICATION STUDIO</p><h1>让每一道尺寸，清晰落地。</h1><p class=\"sub\">从订单到裁剪、画线与缝制，一张图纸串联生产。</p></div><span class=\"version\">原始规则 + 修订批注 · v1.1</span></div>\n<div class=\"order card\"><label>订单编号<input id=\"order\" placeholder=\"输入订单编号\"></label><label>客户名称<input id=\"customer\" placeholder=\"输入客户名称\"></label><label>交付日期<input type=\"date\" id=\"date\"></label><div class=\"order-count\"><strong id=\"count\">01</strong><span>订单项目</span></div></div>\n<div class=\"layout\"><section class=\"editor card\"><div class=\"panel-title\"><h2>订单项目</h2><button id=\"add\" class=\"text-button\">＋ 新增</button></div><div id=\"items\" class=\"items\"></div><form id=\"form\"><div class=\"section-label\">01 / 产品与工艺</div><label>帘型款式<select name=\"style\" id=\"style\"></select></label><div class=\"two\"><label>房间 / 位置<input name=\"room\"></label><label>数量<input name=\"qty\" type=\"number\" min=\"1\" step=\"1\" required></label></div><div class=\"two\"><label>安装方式<select name=\"mount\"><option value=\"IB\">内装 IB</option><option value=\"OB\">外装 OB</option></select></label><label>尺寸单位<select name=\"unit\"><option value=\"in\">英寸 in</option><option value=\"cm\">厘米 cm</option></select></label></div><div class=\"two\"><label>订单宽度<input name=\"width\" type=\"text\" inputmode=\"decimal\" placeholder=\"例如 23 3/4\" required></label><label>订单高度<input name=\"height\" type=\"text\" inputmode=\"decimal\" placeholder=\"例如 44 1/8\" required></label></div><label id=\"controlLabel\">控制系统<select name=\"control\"><option value=\"cordless\">无绳 Cordless</option><option value=\"cco\">拉珠 CCO</option><option value=\"tdbu\">上下开合 TDBU</option><option value=\"dual\">日夜双层 Dual</option><option value=\"motor\">电动 Motorized</option></select></label><div id=\"draperyFields\"><div class=\"two\"><label>开合方式<select name=\"draw\"><option value=\"split\">对开（左右各一片）</option><option value=\"left\">单开 · 向左</option><option value=\"right\">单开 · 向右</option></select></label><label>层次<select name=\"layer\"><option value=\"single\">单层</option><option value=\"over\">双层 · 外层布帘</option><option value=\"under\">双层 · 内层纱帘</option></select></label></div><label>尺寸口径<select name=\"basis\"><option value=\"face\">覆盖宽度（另加回折与前缘）</option><option value=\"finished\">总成品宽度（已含回折与前缘）</option></select></label></div><div class=\"section-label\">02 / 面料与物料</div><label>面料名称 / 客户编码<input name=\"fabric\" placeholder=\"例如 Sevilla RSE-02 Ivory Silk\"></label><label>供应商物料编码<input name=\"supplier\" placeholder=\"例如 DTB026-2K\"></label><label>内衬<select name=\"lining\"><option value=\"privacy\">透光 / 隐私衬里 · Light Filtering</option><option value=\"blackout\">遮光衬里 · Blackout</option><option value=\"none\">无衬里 / 单层 · Unlined</option></select></label><label>特殊备注（中文）<textarea name=\"notes\" rows=\"2\" placeholder=\"回折一片式、面料方向、饰边等\"></textarea></label><details id=\"params\"><summary>工艺参数与调整 <span>⌄</span></summary><p class=\"help\">留空项不会被当作 0。其他帘型参数需由工艺员确认。</p><div id=\"manualRoman\"><div class=\"two\"><label>手工裁剪宽 cm<input name=\"manualW\" type=\"number\" min=\"1\" step=\"any\" placeholder=\"覆盖自动值\"></label><label>手工裁剪高 cm<input name=\"manualH\" type=\"number\" min=\"1\" step=\"any\"></label></div><label>手工水平画线 cm<input name=\"manualMarks\" placeholder=\"如 8, 24.5, 41, 57.5\"></label><p class=\"help\">特殊罗马款可录入专用裁剪及画线，确认后输出。梯绳仍按批注生成，需复核。</p></div><div id=\"draperyParams\"><label>面料类别<select name=\"fabricKind\"><option value=\"cloth\">普通布料（非纱）</option><option value=\"sheer\">纱料</option></select></label><label>工艺参考公司<select id=\"reference-company\"><option value=\"coco\">RM COCO 参考模板</option><option value=\"horizons\">Horizons 参考模板</option></select></label><button type=\"button\" id=\"apply-reference\">填入该公司可确认的参考值</button><p class=\"help\">会覆盖模板包含的字段，保留其他输入。数值需由工艺员核对；公司参考不会自动成为Braun标准。</p><p id=\"reference-detail\" class=\"help\"></p><div class=\"two\"><label>褶量倍数<input name=\"fullness\" type=\"number\" min=\"1\" step=\"any\" placeholder=\"待确认\"></label><label>顶部裁剪余量 cm<input name=\"top\" type=\"number\" min=\"0\" step=\"any\" placeholder=\"待确认\"></label><label>底部裁剪余量 cm<input name=\"bottom\" type=\"number\" min=\"0\" step=\"any\" placeholder=\"待确认\"></label><label>每侧裁剪余量 cm<input name=\"side\" type=\"number\" min=\"0\" step=\"any\" placeholder=\"待确认\"></label><label>每片回折 cm<input name=\"returns\" type=\"number\" min=\"0\" step=\"any\"></label><label>每片前缘 cm<input name=\"leading\" type=\"number\" min=\"0\" step=\"any\"></label><label>对开总交叉量 cm<input name=\"overlap\" type=\"number\" min=\"0\" step=\"any\" placeholder=\"待确认\"></label><label>蛇形扣距 cm<input name=\"snap\" type=\"number\" min=\"0.1\" step=\"any\" placeholder=\"待确认\"></label><label>每片褶数 / 扣数<input name=\"pleats\" type=\"number\" min=\"2\" step=\"1\" placeholder=\"待确认\"></label></div></div><label class=\"check\"><input name=\"confirmed\" type=\"checkbox\"> 已核对本项目工艺参数与尺寸口径</label></details><div class=\"form-actions\"><button type=\"button\" id=\"duplicate\">复制项目</button><button type=\"button\" id=\"remove\" class=\"danger\">删除项目</button></div></form></section>\n<section class=\"preview\"><div class=\"preview-heading\"><div><span class=\"live-dot\"></span> 实时加工预览 <small id=\"saveState\">已保存到本机</small></div><button id=\"svgExport\">↓ 图纸 SVG</button></div><div id=\"output\"></div><div class=\"bottom-actions\"><span>输出前请核对订单尺寸及物料编码</span><button id=\"invoice\">生成 Invoice</button><button id=\"printInvoice\" hidden>打印 Invoice / 保存 PDF</button><button class=\"primary\" id=\"print\">生成加工图纸 / 打印</button></div></section></div></section>\n<section id=\"rules\" hidden><div class=\"title\"><div><p class=\"eyebrow\">PROCESS LIBRARY</p><h1>工艺规则与依据</h1><p class=\"sub\">原始表格保留竖向折线；批注修订尺寸与横向梯绳。</p></div></div><div class=\"card rule-content\"><h2>罗马帘</h2><p>内装 IB：订单宽度转换为厘米后扣减 0.6cm。外装 OB 不扣减。裁剪宽度 = 扣尺后成品宽度 + 左右各 5cm。</p><p>竖向加工高度、档数、档距、画线位置取自原始 Excel 对应高度行，末尾重复画线去重。原表高度先截取至 0.1cm，再向上取 0.5cm。App 显示订单高与加工基准高，避免混淆。支持原表范围与 1/8 英寸高度网格，厘米输入仅在加工基准高与原表一致时匹配，不外推。</p><p>批注修订梯绳边距：成品宽 ≤ 50cm 为 8cm；50cm &lt; 宽 ≤ 190cm 为 10cm；宽 &gt; 190cm 为 15cm。190cm 恰好取 10cm 属连续边界处理。Flat B 横向分档以约 35cm 为目标；前凸、后凸、鱼鳞以约 50cm 为目标且不超过 60cm；以目标间距为上限向上取整分档后等分。实际位置从裁剪左边缘计，包括 5cm 侧折量。</p><p>Hobbled 正确名称为鱼鳞款；Plain Fold 默认对应后凸款，前凸款单独选择。柔纱的前后片分别输出。刀褶、软平、松弛、郁金香、气球款没有原始专用计算表，使用人工工艺参数，不套用其他款式。</p><h2>其他窗帘</h2><p>支持双褶、三褶、欧式双褶、欧式三褶、反折褶、酒杯褶、蛇形帘和韩式帘。蛇形帘标准褶量为 2 倍。对开明确分成左右两片，交叉量单独录入；总成品宽口径不重复增加回折与前缘。</p><p>每片成品宽 =（覆盖宽 + 对开总交叉量）÷ 片数 + 每片回折 + 每片前缘。若选择“总成品宽”，仅将该宽度均分，不再次增加以上项目。每片裁剪宽 = 每片成品宽 × 褶量 + 两侧裁剪余量；裁剪高 = 成品高 + 顶部裁剪余量 + 底部裁剪余量。这是可编辑参数驱动的展开计算，具体褶位工艺需确认。</p><p>单层默认回折 3½″，外层布帘 5½″，内层纱帘不加回折；前缘默认 3½″。下摆成品 4″是说明书结构尺寸，不自动当成裁剪余量。扣距沿展开面料标记，不等同轨道滑车间距。韩式帘必须人工填写工艺参数。</p><h2>新增公司参考（可选）</h2><p>Horizons：PDF第24–25页提供普通布料褶帘2.5倍、双指褶2倍、纱料3倍、蛇形帘2.2倍、标准褶帘回折3.5英寸；第28页的褶数表为特定宽度离散参考，不直接插值成Braun褶位。第27页双折边做法仅明确用于板装侧帘，不扩展到全部Horizons帘型。</p><p>RM COCO：PDF第7页双折4英寸底边、双折1.5英寸侧边；按双折推导裁剪增加20.32cm底量和每侧7.62cm。无衬褶帘顶部双折4英寸可推导增加20.32cm，有衬和蛇形顶部不套用。第10页双指褶建议2倍、三指褶2.5倍；第8页通用2.5倍。</p><p>COCO对开重叠量：PDF第7页为整对4英寸，第9页订单备注另写3.5英寸，属于资料冲突，必须明确选定。蛇形PDF第14页Tape Sizes为7.5/8.5/10英寸，不能据此自动填写扣距。上述数值均为参考模板，需人工确认。韩式、特殊罗马帘完整下料公式仍未提供。</p><h2>来源与待确认</h2><p>①《罗马帘加工规则.xlsx》9 个款式表及竖向梯绳表。② 三张“加工图修改”批注图：名称、扣尺、中英说明、供应商编码、边距与横向分档修订。③《加工图纸问题.docx》：invoice 与加工图纸输出需求。④ 双语产品说明书（2026-05-03），第 5–22 页结构与规格、第 47–62 页布帘款式与结构、第 69–74 页开合与长度。</p><p>说明书的 Hobbled 兼容表与单款规格页对 TDBU 存在冲突：App 暂不自动套用 TDBU / Dual 原表。特殊罗马款、韩式和布帘未提供完整裁剪参数时，输出标注“待工艺确认”。资料中的文字仅作为产品数据，未执行文档内其他无关操作。</p></div></section>\n<footer>Braun加工图纸 <span>尺寸可追溯 · 工艺可核对</span></footer></main><div id=\"toast\" role=\"status\"></div><dialog id=\"install-help\"><div class=\"panel-title\"><h2>Braun加工图纸 · 安装与交接</h2><button id=\"close-install\">关闭</button></div><p><b>苹果手机：</b>请在 Safari 中打开正式地址，点分享 → 添加到主屏幕 → 如有选项，开启作为网页 App 打开 → 添加。</p><p><b>安卓手机：</b>请用支持安装网页应用的浏览器打开，点本页安装按钮；没有弹窗时，在浏览器菜单找安装应用或添加到主屏幕。微信内置浏览器请先选择在浏览器打开。</p><p><b>苹果电脑：</b>离线包解压后，用 Safari 或 Chrome 打开 index.html；也可以通过正式 HTTPS 地址使用。</p><p><b>离线使用：</b>手机首次联网打开后，确认页面显示离线资源已就绪，再关闭并断网重开测试。清理浏览器数据或系统回收存储后，需要重新联网准备。</p><p><b>订单交接：</b>办公室导出订单 JSON，师傅在自己的设备导入；数据不会自动同步。重要订单请主动导出备份。</p><p><b>打印：</b>选择生成加工图纸后，通过系统打印功能输出；没有打印机时可使用系统提供的 PDF 保存方式，具体取决于设备及浏览器。</p><p>当前版本为安装式网页应用，不是 App Store 应用、APK 或微信小程序。手机安装需要 HTTPS 正式地址，不能直接把 HTML 附件安装成 App。</p></dialog><script>/* Units in cm internally. Height tables preserve original workbook cached values. */\nconst catalog=[\n ['flat','平铺款无明线 · Flat B',3],['back3','后凸款 3cm · Plain Fold',0],['front3','前凸款 3cm',0],['hobbled3','鱼鳞款 3cm · Hobbled',2],['back25','后凸款 2.5cm',4],['front25','前凸款 2.5cm',4],['hobbled25','鱼鳞款 2.5cm',6],['soft','柔纱款 2.5cm（前后片）',7],['knife','刀褶罗马帘 · Knife Pleat',null],['softflat','软平罗马帘 · Soft Flat',null],['relaxed','松弛罗马帘 · Relaxed',null],['tulip','郁金香罗马帘 · Tulip',null],['balloon','气球罗马帘 · Balloon',null],\n ['double','双褶布帘 · Double Pinch'],['triple','三褶布帘 · Triple Pinch'],['euro2','欧式双褶 · Euro Double'],['euro3','欧式三褶 · Euro Triple'],['inverted','反折褶 · Inverted'],['goblet','酒杯褶 · Goblet'],['ripple','蛇形帘 · Ripple Fold'],['korean','韩式帘（人工工艺参数）']\n];\nconst round=n=>Math.round((n+Number.EPSILON)*100)/100;\nconst f=n=>Number.isFinite(n)?String(round(n)):'待确认';\nconst has=v=>String(v??'').trim()!==''&&Number.isFinite(Number(v));\nfunction dimensionNumber(value){\n const text=String(value??'').trim().replace(/[″”\"]/g,'').trim();\n const m=text.match(/^(?:(\\d+)\\s+)?(\\d+)\\s*\\/\\s*(\\d+)$/);\n if(m){const whole=Number(m[1]||0),top=Number(m[2]),bottom=Number(m[3]);return bottom>0&&top<bottom?whole+top/bottom:NaN;}\n return /^\\d+(?:\\.\\d+)?$/.test(text)?Number(text):NaN;\n}\nfunction markPositions(values,cut){\n const marks=[...new Set(values)];\n if(marks.some(v=>!Number.isFinite(v)||v<0||v>cut))throw Error('画线超出裁剪范围，请核对原表或人工参数。');\n return marks.sort((a,b)=>a-b);\n}\nfunction normalizeOrder(v){\n if(!v||!Array.isArray(v.items)||!v.items.length||v.items.length>100)throw Error('订单项目数量无效。');\n const items=v.items.map(raw=>{\n  const x={...base(),...raw};\n  if(!catalog.some(c=>c[0]===x.style)||!['in','cm'].includes(x.unit)||!['IB','OB'].includes(x.mount)||!Number.isInteger(Number(x.qty))||Number(x.qty)<1||!Number.isFinite(dimensionNumber(x.width))||dimensionNumber(x.width)<=0||!Number.isFinite(dimensionNumber(x.height))||dimensionNumber(x.height)<=0)throw Error('订单尺寸、数量或选项无效。');\n  x.confirmed=raw.confirmed===true;\n  return x;\n });\n return {order:String(v.order||''),customer:String(v.customer||''),date:String(v.date||''),currency:['USD','CNY','CAD'].includes(v.currency)?v.currency:'USD',items};\n}\nfunction referencePreset(x,company){\n const pleated=['double','triple','euro2','euro3','inverted','goblet'].includes(x.style);\n if(!pleated&&x.style!=='ripple')throw Error('两家公司未提供此款可直接对应的完整参考参数；请保留人工工艺。');\n if(!['horizons','coco'].includes(company))throw Error('请选择参考公司');\n const v={},notes=[];let pages='';\n if(company==='horizons'){\n  pages='Horizons PDF第24–25页（印刷页24–25）';\n  v.fullness=x.style==='ripple'?2.2:x.fabricKind==='sheer'?3:['double','euro2'].includes(x.style)?2:2.5;\n  notes.push('欧式双/三褶按双/三指褶近似对应，仅作参考。');\n  if(pleated){v.returns=8.89;v.leading=0;notes.push('回折为褶帘标准3.5英寸；交叉量单独填写，前缘不重复增加。');}\n  else notes.push('蛇形帘为本公司2.2倍，与Braun的2倍不同；仅修改褶量，不套用其他公司的五金。');\n  notes.push('未套用Horizons内装高度扣3/4英寸，订单高度仍按Braun现有口径。上下/侧裁剪余量未查到适用于此款的通用完整值。');\n }else{\n  pages='RM COCO PDF第7、8、10、14页（印刷页13、14、19、26）';\n  if(pleated){v.fullness=['double','euro2'].includes(x.style)?2:2.5;v.returns=8.89;v.leading=0;notes.push('双指褶2倍、三指褶2.5倍；其他列出褶型暂按通用2.5倍参考。欧式款为近似对应。');}\n  v.bottom=20.32;v.side=7.62;\n  if(pleated&&x.lining==='none'){v.top=20.32;notes.push('无衬褶帘顶部双折4英寸，按两折推导增加8英寸；有衬结构不同，不自动填顶部。');}\n  notes.push('底边双折4英寸→裁剪增加8英寸=20.32cm；侧边双折1.5英寸→每侧增加3英寸=7.62cm。以上为按双折做法推导的裁剪量，非原文直接给出的裁剪公式。厚重或疏松面料需另核。');\n  notes.push('对开重叠量原文一般结构为整对4英寸，但订单页另写3.5英寸，未自动选择。');\n  if(x.style==='ripple')notes.push('COCO列出60/80/100/120%褶量档及7.5/8.5/10英寸Tape Sizes；没有直接说明本项目扣距，不自动换算或填写。顶部扣带加工余量需另核。');\n }\n return {...v,referenceCompany:company,referenceSource:pages,referenceNote:notes.join(' '),confirmed:false};\n}\nfunction calculate(x,tables){\n const c=catalog.find(c=>c[0]===x.style);if(!c)throw Error('未知帘型');\n if(!['in','cm'].includes(x.unit)||!['IB','OB'].includes(x.mount))throw Error('尺寸单位或安装方式无效。');\n const w=dimensionNumber(x.width)*(x.unit==='in'?2.54:1),h=dimensionNumber(x.height)*(x.unit==='in'?2.54:1);\n if(!Number.isFinite(w)||!Number.isFinite(h)||w<=0||h<=0||!Number.isInteger(Number(x.qty))||x.qty<1)throw Error('请输入有效的宽度、高度和整数数量。');\n const roman=c.length===3, notices=[],pending=[];\n if(roman){\n  const fw=round(w-(x.mount==='IB'?.6:0));if(fw<=16)throw Error('扣尺后宽度过小，无法布置梯绳。');\n  let idx=c[2];\n  if(x.control==='tdbu'){if(['back3','front3'].includes(x.style))idx=1;else if(['back25','front25'].includes(x.style))idx=5;else if(x.style==='soft')idx=8;else {idx=null;pending.push('此款上下开合专用加工规则')}}\n  if(x.control==='dual'&&x.style!=='soft'){idx=null;pending.push('日夜双层的独立加工规则')}\n  let row=null;\n  if(idx!=null){const inch=h/2.54,baseline=Math.ceil((Math.floor((h+1e-7)*10)/10-1e-7)*2)/2;row=x.unit==='in'?tables[idx].find(r=>Math.abs(r.inch-inch)<.00001):tables[idx].find(r=>Math.abs(r.height-baseline)<.00001);if(!row)pending.push('高度未匹配原表（请使用原表范围内的 1/8 英寸高度）')}\n  let edge=fw<=50?8:fw<=190?10:15;\n  const available=fw-edge*2,target=x.style==='flat'?35:50;let intervals=Math.max(1,Math.ceil(available/target));\n  const cords=Array.from({length:intervals+1},(_,i)=>round(5+edge+available/intervals*i));\n  const inchW=fw/2.54,inchH=h/2.54;\n  const lim=x.control==='cordless'?[16,24,x.style.startsWith('hobbled')?72:84,x.style.startsWith('hobbled')?72:84]:x.control==='cco'?[18,20,72,x.style.startsWith('hobbled')?84:96]:['tdbu','dual'].includes(x.control)?[18,24,72,72]:[21,18,96,120];\n  if(inchW<lim[0]||inchH<lim[1]||inchW>lim[2]||inchH>lim[3]){pending.push('尺寸超出当前系统通用规格范围，需核定专用规格')}\n  if(x.style.startsWith('hobbled')&&['tdbu','dual'].includes(x.control